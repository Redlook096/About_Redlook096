index b1525d1..2daad29 100644
--- a/scripts/opencluely-bridge/main.js
+++ b/scripts/opencluely-bridge/main.js
@@ -108,6 +108,7 @@ const desktopControl = require("./src/services/desktop-control.service");
 // Managers
 const windowManager = require("./src/managers/window.manager");
 const sessionManager = require("./src/managers/session.manager");
